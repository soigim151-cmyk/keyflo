rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // posts/{postId}/comments/{commentId} — anyone can read and add a comment;
    // nobody can edit or delete from the site (delete unwanted ones in the Firebase console).
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if postId in ['1','2','3','4','5','6','7','8','9']
        && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
