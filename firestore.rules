rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One site-wide counter: n = last comment number handed out.
    // It can only go up by exactly 1, and only together with creating comments/c{n}.
    match /counters/comments {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1
        && existsAfter(/databases/$(database)/documents/comments/c1);
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/comments/$('c' + string(request.resource.data.n)));
      allow delete: if false;
    }

    // comments/c{num} = { post, num, text, uid, createdAt }
    // Anyone can read. Visitors (signed in anonymously) can add one with the next number,
    // and can delete only their own. Nobody can edit.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'num', 'text', 'uid', 'createdAt'])
        && request.resource.data.post in ['1','2','3','4','5','6','7','8','9']
        && request.resource.data.num is int
        && commentId == 'c' + string(request.resource.data.num)
        && getAfter(/databases/$(database)/documents/counters/comments).data.n == request.resource.data.num
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
